# ============================================================================
# CodeLens AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# ─── Database (Neon PostgreSQL — Free Tier) ─────────────────────────────────
# Get from: https://neon.tech → Create Project → Connection Details
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=60"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/neondb?sslmode=require&connect_timeout=60"

# ─── Authentication (Better-Auth) ───────────────────────────────────────────
# Generate a random string: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret-here
# Set to your deployed URL in production (e.g., https://codelensai.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── App URLs ────────────────────────────────────────────────────────────────
# In production, set both to your Vercel domain
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:3000

# ─── Pinecone (Vector DB — Free Tier) ───────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
PINECONE_DB_API_KEY=your-pinecone-api-key

# ─── Google Gemini (Free Tier) ──────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
# Primary key for embeddings (used by @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
# Primary key for LLM (code reviews)
GEMINI_API_KEY=your-google-api-key
# Backup key (optional — used if primary hits quota)
GEMINI_BACKUP_API_KEY=
# Separate key for AI tools (summarize, generate, playground)
GEMINI_AI_TOOLS_API_KEY=your-google-api-key

# ─── OpenRouter (Optional — can remove for free deployment) ─────────────────
OPENROUTER_API_KEY=

# ─── OpenAI (Optional — can remove for free deployment) ─────────────────────
OPENAI_API_KEY=

# ─── Polar (Subscription/Payments — Free for Open Source) ───────────────────
# Get from: https://polar.sh → Settings → Developer
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_PRODUCT_ID=your-product-uuid
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
POLAR_SUCCESS_URL=http://localhost:3000

# ─── EmailJS (Free Tier — 200 emails/month) ─────────────────────────────────
# Get from: https://www.emailjs.com → Account → API Keys
EMAILJS_SERVICE_ID=your-service-id
EMAILJS_TEMPLATE_ID=your-template-id
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_PRIVATE_KEY=your-private-key

# ─── Python AI Sidecar ──────────────────────────────────────────────────────
# Shared secret between Next.js and Python sidecar (generate a random string)
PYTHON_AI_API_KEY=your-random-api-key
# URL of the Python sidecar (Render URL in production)
PYTHON_AI_URL=http://localhost:8000
