# Required env vars for python-sidecar — copy to .env and fill in values

# Shared secret — must match PYTHON_AI_API_KEY in the Next.js .env
PYTHON_AI_API_KEY=change-me-use-a-long-random-string

# Pinecone (same key as the Next.js side)
PINECONE_DB_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=codelens

# Google / Gemini — primary LLM + embeddings (3072-dim, MUST match TS pipeline)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# LLM Provider: "gemini" (production) or "ollama" (local dev)
LLM_PROVIDER=gemini

# CORS — comma-separated allowed origins
# Production: set to your Vercel domain (e.g., https://codelensai.vercel.app)
CORS_ORIGINS=http://localhost:3000

# Ollama settings (only used when LLM_PROVIDER=ollama or OLLAMA_ENABLED=true)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_FALLBACK_MODEL=phi3:mini
